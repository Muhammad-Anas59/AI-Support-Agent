<!DOCTYPE html>
<html lang="en">
<head>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏃</text></svg>">
<meta charset="UTF-8">
<title>Verve Athletics</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #F6F4EF;
    color: #10151F;
  }
  header {
    background: #1B2438;
    color: #F6F4EF;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  header .logo {
    font-weight: 800;
    letter-spacing: 0.08em;
    font-size: 18px;
  }
  header .logo span { color: #F5A623; }
  nav a {
    color: #A9B3C9;
    text-decoration: none;
    margin-left: 28px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero {
    padding: 100px 40px;
    text-align: center;
  }
  .hero h1 {
    font-size: 48px;
    font-weight: 800;
    letter-spacing: -0.02em;
    max-width: 700px;
    margin: 0 auto 16px;
  }
  .hero p {
    color: #4A5468;
    font-size: 17px;
    max-width: 480px;
    margin: 0 auto;
  }
  .note {
    max-width: 480px;
    margin: 40px auto 0;
    padding: 16px 20px;
    background: #fff;
    border: 1px solid #E6E1D6;
    border-radius: 12px;
    font-size: 13px;
    color: #4A5468;
    text-align: left;
  }
  .note strong { color: #10151F; }
</style>
</head>
<body>

<header>
  <div class="logo">VERVE<span>ATHLETICS</span></div>
  <nav>
    <a href="#">Shop</a>
    <a href="#">Men</a>
    <a href="#">Women</a>
    <a href="#">Support</a>
  </nav>
</header>

<div class="hero">
  <h1>Built for movement. Backed by real support.</h1>
  

  <div class="note">
  <p>Engineered activewear for training, recovery, and everything in between. Questions about sizing, shipping, or your order? Our support team is one click away.</p> 
  </div>
</div>

<script>
  // Point the widget at your local chat_api.py server
  window.VERVE_CHAT_API = "https://verve-support.duckdns.org";
</script>
<script src="widget.js"></script>

</body>
</html>
